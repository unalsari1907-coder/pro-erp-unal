+  Map<String, dynamic>? get _secilenCari {
+    final id = _secilenCariId;
+    if (id == null) return null;
+    for (final cari in _cariler) {
+      if (int.tryParse(cari['cari_id']?.toString() ?? '') == id) return cari;
+    }
+    return null;
+  }
+
+  String _cariBakiyeDurumu(Map<String, dynamic> cari) {
+    final bakiye = _sayi(cari['bakiye']);
+    final tip = _metin(cari['cari_tipi']).toUpperCase();
+    if (bakiye == 0) return 'HESAP KAPALI';
+    if (tip.contains('TEDARIK') || tip.contains('TEDARİK')) {
+      return bakiye > 0
+          ? 'TEDARİKÇİYE BORÇLUYUZ'
+          : 'TEDARİKÇİDEN ALACAKLIYIZ';
+    }
+    return bakiye > 0
+        ? 'MÜŞTERİDEN ALACAKLIYIZ'
+        : 'MÜŞTERİYE BORÇLUYUZ';
+  }
+
+  Color _cariBakiyeRengi(Map<String, dynamic> cari) {
+    final durum = _cariBakiyeDurumu(cari);
+    if (durum.contains('ALACAKLIYIZ')) return Colors.green.shade700;
+    if (durum.contains('BORÇLUYUZ')) return Colors.red.shade700;
+    return Colors.grey.shade700;
+  }
